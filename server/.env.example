# All variables are optional; the defaults below are used when unset.

# Port for the API server
PORT=4000

# Path to the SQLite database file (created automatically)
DB_PATH=./data/tickets.db

# Comma-separated list of origins allowed by CORS
CORS_ORIGIN=http://localhost:5173

# Winston log level: error | warn | info | http | debug
LOG_LEVEL=http

# Secret used to sign JWTs — set a strong random value in production
JWT_SECRET=dev-only-secret-change-me

# Number of reverse proxies in front of the app (1 when behind the nginx container)
TRUST_PROXY=0

# Rate limiting (requests per 15-minute window per IP)
RATE_LIMIT_MAX=300
RATE_LIMIT_WRITE_MAX=60
RATE_LIMIT_LOGIN_MAX=20
